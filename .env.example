# Copy to .env for local API use. Never commit .env.
# Set either OPENAI_API_KEY or GROQ_API_KEY.
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Alternatively, configure Groq:
# GROQ_API_KEY=gsk_your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: Embedding provider ("openai", "huggingface", "sentence-transformers", "hash")
# Defaults to OpenAI if OPENAI_API_KEY is present, or Hugging Face Inference API / Hash.
# EMBEDDING_PROVIDER=openai
# HF_TOKEN=your-huggingface-token-if-using-huggingface

# Optional comma-separated list of trusted frontend origins for deployment.
# FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

